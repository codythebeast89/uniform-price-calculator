[Unit]
Description=QMC Uniform Price Calculator (OAuth + awards API)
After=network.target

[Service]
Type=simple
User=codyb
WorkingDirectory=/opt/qmc-calc/server
EnvironmentFile=/opt/qmc-calc/server/.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
