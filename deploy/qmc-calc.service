[Unit]
Description=QMC Uniform Price Calculator (OAuth + awards API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# __REMOTE_DIR__ is substituted with the real deploy path by
# scripts/deploy-imperial.sh at install time — do not hardcode a real path here.
WorkingDirectory=__REMOTE_DIR__/server
EnvironmentFile=__REMOTE_DIR__/server/.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
