[Unit]
Description=QMC Uniform Price Calculator (OAuth + awards API)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/codyb/stacks/qmc-calc/server
EnvironmentFile=/home/codyb/stacks/qmc-calc/server/.env
ExecStart=/usr/bin/node src/server.mjs
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
